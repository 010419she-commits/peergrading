# ===== 基本 =====
PORT=3000
NODE_ENV=production                    # 生产必须；本地开发可不设
BASE_URL=https://peergrading.ai          # 生产必须 https；本地默认 http://localhost:3000
SESSION_SECRET=                        # openssl rand -hex 32（≥32 字符）；本地开发缺省会自动生成到 data/.session-secret
# DEV_LOGIN=1                          # 仅本地：启用“开发者登录”假身份，便于走通全流程（生产无效）

# ===== Google 登录 =====（Google Cloud Console → Credentials → OAuth client ID (Web)；回调 ${BASE_URL}/auth/google/callback）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== GitHub 登录 =====（GitHub Settings → Developer settings → OAuth Apps）
# Homepage URL=${BASE_URL}；Authorization callback URL=${BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===== 邮箱验证码登录 =====（二选一：smtp 或 resend；未配置时明确显示尚未开放，不会发模拟验证码）
# 见 docs/email-login-setup.md。只在服务器填写，不打包到桌面客户端。
EMAIL_PROVIDER=                       # smtp / resend；留空关闭邮箱验证码入口
EMAIL_FROM=                           # 例 PeerGrading <login@auth.peergrading.ai>，须为服务商允许的发件地址
SMTP_HOST=
SMTP_PORT=465                        # 465 使用隐式 TLS；587 使用 STARTTLS，按服务商要求
SMTP_SECURE=true                     # 465=true；587=false（连接会要求 STARTTLS）
SMTP_USER=
SMTP_PASS=                           # 邮箱服务提供的 SMTP 凭证或应用专用密码，不是用户的登录密码
RESEND_API_KEY=                      # EMAIL_PROVIDER=resend 时必填
# EMAIL_TEST_OUTBOX_DIR=              # 仅 NODE_ENV=test 的隔离自动化测试使用，生产忽略；不用于真实邮件验收

# ===== 内测与后台 =====
# FREE_BETA=0                          # 内测免费默认开（所有登录用户免费、不开放购买）。后台 /admin 的开关优先于此处；设 0 仅改变没有后台设置时的默认值
ADMIN_USER_IDS=                        # 管理员用户 ID（逗号分隔，账号页可查看）；也可用 npm run grant -- <id> admin permanent

# ===== 试用与定价 =====
TRIAL_DAYS=3
TRIAL_USES=5
PRICE_CENTS=1800                       # 18 元 / 月
CURRENCY=CNY                           # 海外发布可改 USD，并相应调整 PRICE_CENTS
PLAN_MODE=days                         # days = 按月（PLAN_DAYS 天）订阅，到期可续；permanent = 一次买断
PLAN_DAYS=30
PRODUCT_NAME=双 Agent 协作循环
EARLY_BIRD_LIMIT=200                   # 早鸟终身版名额（前 N 名）；后台可改
EARLY_BIRD_PRICE_CENTS=9900            # 早鸟价 99 元；后台可改
REFERRAL_DAYS=7                        # 邀请奖励：邀请者与被邀请者各得天数；后台可改
REFERRAL_MAX=20                        # 每人最多因邀请获奖的次数（防刷）
REFERRAL_CLAIM_DAYS=7                  # 被邀请者注册后多少天内还能手动填邀请码

# ===== 收款 =====（也可在后台 /admin 填写并上传收款码，后台设置优先）
PAY_INSTRUCTIONS=                      # 下单后展示给用户的付款说明（例如“微信扫码付款并备注订单号”）
PAY_QR_URL=                            # 收款码图片地址（可放 public/ 下）
PAYMENT_WEBHOOK_SECRET=                # 支付回调验签密钥（HMAC-SHA256 of raw body → x-signature）
MERCHANT_ID=default

# ===== 图片 / 视频生成（协作中由智能体按需生成，OpenAI gpt-image-1 / Sora）=====
# 也可在工作台侧栏里填（桌面版任何人、网页版仅管理员），保存到 data/media.json，优先于此处
# MEDIA_API_KEY=                       # 或 OPENAI_API_KEY
# MEDIA_BASE_URL=https://api.openai.com/v1   # 兼容 OpenAI 的中转站也可
# MEDIA_IMAGE_MODEL=gpt-image-1
# MEDIA_VIDEO_MODEL=sora-2
# MEDIA_MAX_IMAGES=6                   # 每次协作最多生成的图片 / 视频数
# MEDIA_MAX_VIDEOS=2

# ===== 其他 =====
# KIMI_API_KEY=                        # 有则自动出现“Kimi Code”全自动项
# SCAN_MODELS=1                        # 同时列出 LM Studio / Ollama 本地模型与 ANTHROPIC_API_KEY 直连

# ===== 微信支付 Native（与邮箱、Google / GitHub 登录独立配置） =====
# 申请与联调步骤见 docs/payments-setup.md。密钥文件不要放 public/、仓库或安装包内。
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=                    # 已与商户号关联、开通 Native 支付的 AppID
WECHAT_PAY_CERT_SERIAL=               # 商户 API 证书序列号
WECHAT_PAY_PRIVATE_KEY_PATH=          # 商户 API 私钥 PEM，建议使用仓库外的绝对路径
WECHAT_PAY_API_V3_KEY=                # 32 字节 APIv3 密钥
WECHAT_PAY_PLATFORM_KEY_ID=           # 微信支付公钥 ID（PUB_KEY_ID_...）或受信任平台证书序列号
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=  # 上述 ID 对应的受信任 RSA 公钥 PEM

# ===== 海外 Visa / Mastercard：Airwallex 全球收单（大陆主体需申请并获批） =====
AIRWALLEX_ENV=sandbox                 # 先用 sandbox；生产账户联调完成后改 production
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_ACCOUNT_ID=                 # 本商户账户 ID，校验 webhook 归属
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_COUNTRY_CODE=US             # 默认买家国家代码，按实际市场配置；不是公司注册地
# 回调 URL：${BASE_URL}/api/billing/webhooks/wechat、${BASE_URL}/api/billing/webhooks/airwallex
# FREE_BETA=1（默认）时保持免费，不会开放购买；商户联调通过后在 /admin 关闭内测免费。
