# ===== 基本 =====
PORT=3000
NODE_ENV=production                    # 生产必须；本地开发可不设
BASE_URL=https://peergrading.ai          # 生产必须 https；本地默认 http://localhost:3000
SESSION_SECRET=                        # openssl rand -hex 32（≥32 字符）；本地开发缺省会自动生成到 data/.session-secret
# DEV_LOGIN=1                          # 仅本地：启用“开发者登录”假身份，便于走通全流程（生产无效）

# ===== Google 登录 =====（Google Cloud Console → Credentials → OAuth client ID (Web)；回调 ${BASE_URL}/auth/google/callback）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== 微信登录 =====（open.weixin.qq.com 开放平台 → 网站应用，审核通过后得到 AppID / AppSecret；「授权回调域」填裸域名 peergrading.ai；服务器上可用 deploy/set-wechat.sh 填写）
WECHAT_OPEN_APPID=
WECHAT_OPEN_SECRET=
WECHAT_OPEN_UNION_DOMAIN=              # 代表该开放平台账号的稳定字符串（例如公司名），用于把扫码与公众号登录按 UnionID 认成同一人；留空则不关联
WECHAT_MP_APPID=                       # 可选：公众号（用户在微信内置浏览器里打开站点时用公众号授权登录）
WECHAT_MP_SECRET=
WECHAT_MP_UNION_DOMAIN=

# ===== 内测与后台 =====
# FREE_BETA=0                          # 内测免费默认开（所有登录用户免费、不开放购买）。后台 /admin 的开关优先于此处；设 0 仅改变没有后台设置时的默认值
ADMIN_USER_IDS=                        # 管理员用户 ID（逗号分隔，账号页可查看）；也可用 npm run grant -- <id> admin permanent

# ===== 试用与定价 =====
TRIAL_DAYS=3
TRIAL_USES=5
PRICE_CENTS=1800                       # 18 元 / 月
CURRENCY=CNY                           # 海外发布可改 USD，并相应调整 PRICE_CENTS
PLAN_MODE=days                         # days = 按月（PLAN_DAYS 天）订阅，到期可续；permanent = 一次买断
PLAN_DAYS=30
PRODUCT_NAME=双 Agent 协作循环
EARLY_BIRD_LIMIT=200                   # 早鸟终身版名额（前 N 名）；后台可改
EARLY_BIRD_PRICE_CENTS=9900            # 早鸟价 99 元；后台可改
REFERRAL_DAYS=7                        # 邀请奖励：邀请者与被邀请者各得天数；后台可改
REFERRAL_MAX=20                        # 每人最多因邀请获奖的次数（防刷）

# ===== 收款 =====（也可在后台 /admin 填写并上传收款码，后台设置优先）
PAY_INSTRUCTIONS=                      # 下单后展示给用户的付款说明（例如“微信扫码付款并备注订单号”）
PAY_QR_URL=                            # 收款码图片地址（可放 public/ 下）
PAYMENT_WEBHOOK_SECRET=                # 支付回调验签密钥（HMAC-SHA256 of raw body → x-signature）
MERCHANT_ID=default

# ===== 图片 / 视频生成（协作中由智能体按需生成，OpenAI gpt-image-1 / Sora）=====
# 也可在工作台侧栏里填（桌面版任何人、网页版仅管理员），保存到 data/media.json，优先于此处
# MEDIA_API_KEY=                       # 或 OPENAI_API_KEY
# MEDIA_BASE_URL=https://api.openai.com/v1   # 兼容 OpenAI 的中转站也可
# MEDIA_IMAGE_MODEL=gpt-image-1
# MEDIA_VIDEO_MODEL=sora-2
# MEDIA_MAX_IMAGES=6                   # 每次协作最多生成的图片 / 视频数
# MEDIA_MAX_VIDEOS=2

# ===== 其他 =====
# KIMI_API_KEY=                        # 有则自动出现“Kimi Code”全自动项
# SCAN_MODELS=1                        # 同时列出 LM Studio / Ollama 本地模型与 ANTHROPIC_API_KEY 直连
