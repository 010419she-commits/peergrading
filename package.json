{
  "name": "peergrading",
  "version": "0.6.2",
  "private": true,
  "license": "MIT",
  "author": "PeerGrading contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/010419she-commits/peergrading.git"
  },
  "type": "module",
  "description": "PeerGrading · 本地与云端 AI 智能体互相审查、讨论、修改的开源协作循环",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env site-server.ts",
    "dev": "npm run bundle && node --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/dev.mjs",
    "bundle": "npm run bundle:vendor && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs && esbuild site-server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/site-server.mjs",
    "bundle:vendor": "esbuild web/app-vendor.ts --bundle --platform=browser --format=iife --minify --outfile=public/app-vendor.js",
    "desktop": "npm run bundle && node scripts/desktop.cjs",
    "dist:mac": "npm run bundle && electron-builder --mac",
    "dist:win": "npm run bundle && electron-builder --win --x64 --arm64",
    "dist:all": "npm run bundle && electron-builder --mac --win --x64 --arm64",
    "test": "node --test test/*.test.ts",
    "check:open-source": "node scripts/check-open-source.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "dompurify": "^3.1.6",
    "express": "^4.22.3",
    "marked": "^12.0.2",
    "shell-quote": "^1.12.0",
    "smol-toml": "^1.9.1",
    "undici": "^8.12.2"
  },
  "main": "desktop/main.cjs",
  "devDependencies": {
    "@electron/windows-sign": "^1.2.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "ai.peergrading.desktop",
    "productName": "PeerGrading",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "dist/**",
      "public/**",
      "views/**",
      "agents/**",
      "finalizer/**",
      "package.json",
      "LICENSE",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true,
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "dmg": {
      "title": "PeerGrading"
    },
    "icon": "build/icon.png"
  }
}
